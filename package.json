{
  "name": "delegates-modern",
  "version": "0.1.0",
  "description": "A modern, dependency-free TypeScript-first alternative to delegates for Node.js object and method delegation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "COMPATIBILITY.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "keywords": [
    "delegates",
    "delegation",
    "object-delegation",
    "property-delegation",
    "nodejs",
    "typescript",
    "javascript",
    "esm",
    "commonjs"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-cjs.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm pack --dry-run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.types.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test test/*.mjs",
    "coverage": "npm run build && node --test --experimental-test-coverage test/*.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "bench": "npm run build && node bench/bench.mjs",
    "pack:check": "npm run check && npm pack --dry-run"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Crynspier/delegates-modern.git"
  },
  "bugs": {
    "url": "https://github.com/Crynspier/delegates-modern/issues"
  },
  "homepage": "https://github.com/Crynspier/delegates-modern#readme"
}
